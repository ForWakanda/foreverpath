<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd">
	<!-- Mouse scripts are wired by MapCanvasMixin:AcquirePin from the mixin methods; no <Scripts> block, same as Blizzard's WaypointLocationPinTemplate. -->
	<Frame name="HearthAndHustleMapPinTemplate" enableMouse="true" enableMouseClicks="true" mixin="HearthAndHustleMapPinMixin" virtual="true">
		<Size x="24" y="24"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Icon" atlas="Waypoint-MapPin-Untracked">
					<Size x="24" y="24"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture parentKey="Highlight" atlas="Waypoint-MapPin-Highlight">
					<Size x="24" y="24"/>
					<Anchors>
						<Anchor point="CENTER" relativeKey="$parent.Icon"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Frame>
	<Frame name="HearthAndHustleObjectivePinTemplate" enableMouse="true" enableMouseClicks="true" mixin="HearthAndHustleObjectivePinMixin" virtual="true">
		<Size x="12" y="12"/>
		<Layers><Layer level="BACKGROUND"><Texture parentKey="Icon" file="Interface\AddOns\HearthAndHustle\Media\pin">
			<Size x="12" y="12"/><Anchors><Anchor point="CENTER"/></Anchors>
		</Texture></Layer></Layers>
	</Frame>
</Ui>
